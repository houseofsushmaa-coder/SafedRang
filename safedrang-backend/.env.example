# ==================================================
# SERVER
# ==================================================
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# ==================================================
# DATABASE
# ==================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/safedrang?schema=public"

# ==================================================
# JWT
# ==================================================
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==================================================
# RAZORPAY
# ==================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==================================================
# AWS S3 (for image uploads)
# ==================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=safedrang-media

# ==================================================
# EMAIL (SMTP)
# ==================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@safedrang.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="Safed Rang <noreply@safedrang.com>"

# ==================================================
# SHIPROCKET
# ==================================================
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password

# ==================================================
# BUSINESS
# ==================================================
BUSINESS_NAME="Safed Rang"
BUSINESS_GSTIN=YOUR_GSTIN_HERE
BUSINESS_ADDRESS="Your Business Address, Lucknow, UP, 226001"
INVOICE_PREFIX=SR
