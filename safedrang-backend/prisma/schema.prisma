// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────
enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ORDER_MANAGER
  PRODUCT_MANAGER
  CUSTOMER_SUPPORT
  VIEW_ONLY
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAYMENT_INITIATED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

enum PaymentMethod {
  CASHFREE
  COD
  BANK_TRANSFER
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum InventoryTransactionType {
  SALE
  RETURN
  ADJUSTMENT
  IMPORT
  DAMAGE
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ShipmentStatus {
  CREATED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum NotificationType {
  ORDER
  PAYMENT
  INVENTORY
  SYSTEM
  MARKETING
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

// ─── MODELS ─────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  phone         String?    @unique
  passwordHash  String
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  refreshTokens RefreshToken[]
  customer      Customer?
  notifications Notification[]
  auditLogs     AuditLog[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([email])
  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Customer {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  totalOrders Int       @default(0)
  totalSpent  Decimal   @default(0) @db.Decimal(12, 2)
  addresses   Address[]
  orders      Order[]
  wishlists   Wishlist[]
  coupons     CouponUsage[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@map("customers")
}

model Address {
  id           String      @id @default(uuid())
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         AddressType @default(HOME)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String      @default("India")
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([customerId])
  @@map("addresses")
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]     @relation("CategoryHierarchy")
  products    Product[]
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  sku               String            @unique
  description       String?           @db.Text
  shortDescription  String?
  price             Decimal           @db.Decimal(10, 2)
  salePrice         Decimal?          @db.Decimal(10, 2)
  costPrice         Decimal?          @db.Decimal(10, 2)
  stock             Int               @default(0)
  lowStockThreshold Int               @default(5)
  status            ProductStatus     @default(DRAFT)
  featured          Boolean           @default(false)
  bestseller        Boolean           @default(false)
  newArrival        Boolean           @default(false)
  weight            Decimal?          @db.Decimal(8, 3)
  categoryId        String?
  category          Category?         @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  orderItems        OrderItem[]
  inventoryTxns     InventoryTransaction[]
  wishlists         Wishlist[]
  seoTitle          String?
  seoDescription    String?
  seoKeywords       String?
  hsnCode           String?
  taxRate           Decimal           @default(0) @db.Decimal(5, 2)
  fabric            String?
  craft             String?
  care              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id         String     @id @default(uuid())
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String     @unique
  price      Decimal?   @db.Decimal(10, 2)
  salePrice  Decimal?   @db.Decimal(10, 2)
  stock      Int        @default(0)
  attributes Json       @default("{}")
  orderItems OrderItem[]
  inventoryTxns InventoryTransaction[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model Order {
  id                String            @id @default(uuid())
  orderNumber       String            @unique
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  subtotal          Decimal           @db.Decimal(12, 2)
  discount          Decimal           @default(0) @db.Decimal(12, 2)
  shippingCharge    Decimal           @default(0) @db.Decimal(10, 2)
  tax               Decimal           @default(0) @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(12, 2)
  paymentStatus     PaymentStatus     @default(PENDING)
  orderStatus       OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  paymentMethod     PaymentMethod     @default(CASHFREE)
  couponId          String?
  coupon            Coupon?           @relation(fields: [couponId], references: [id])
  billingAddress    Json?
  shippingAddress   Json?
  customerNote      String?
  adminNote         String?
  shippingMethod    String?
  payments          Payment[]
  refunds           Refund[]
  shipments         Shipment[]
  statusHistory     OrderStatusHistory[]
  invoiceNumber     String?
  invoiceUrl        String?
  couponUsages      CouponUsage[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([orderNumber])
  @@index([customerId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String
  sku         String
  quantity    Int
  price       Decimal         @db.Decimal(10, 2)
  total       Decimal         @db.Decimal(12, 2)
  tax         Decimal         @default(0) @db.Decimal(10, 2)
  discount    Decimal         @default(0) @db.Decimal(10, 2)
  imageUrl    String?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id])
  gateway               String
  transactionId         String?       @unique
  cfOrderId             String?       // Cashfree order_id
  cfPaymentSessionId    String?       // Cashfree payment_session_id
  cfPaymentId           String?       // Cashfree cf_payment_id after capture
  idempotencyKey        String?       @unique // prevents duplicate payment creation
  webhookEventId        String?       // Cashfree webhook event ID for idempotency
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("INR")
  status                PaymentStatus @default(PENDING)
  gatewayResponse       Json?
  refunds               Refund[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId])
  @@index([transactionId])
  @@index([cfOrderId])
  @@map("payments")
}

model Refund {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id])
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  reason         String?
  status         RefundStatus @default(PENDING)
  gatewayRefundId String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

model Coupon {
  id                 String      @id @default(uuid())
  code               String      @unique
  type               CouponType  @default(PERCENTAGE)
  value              Decimal     @db.Decimal(10, 2)
  minimumOrderAmount Decimal?    @db.Decimal(10, 2)
  maximumDiscount    Decimal?    @db.Decimal(10, 2)
  usageLimit         Int?
  usedCount          Int         @default(0)
  perCustomerLimit   Int?
  firstOrderOnly     Boolean     @default(false)
  startDate          DateTime?
  expiryDate         DateTime?
  status             Boolean     @default(true)
  applicableProducts Json?
  applicableCategories Json?
  orders             Order[]
  usages             CouponUsage[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([code])
  @@map("coupons")
}

model CouponUsage {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  usedAt     DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([customerId])
  @@map("coupon_usages")
}

model InventoryTransaction {
  id            String                   @id @default(uuid())
  productId     String
  product       Product                  @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant?          @relation(fields: [variantId], references: [id])
  type          InventoryTransactionType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  referenceId   String?
  createdAt     DateTime                 @default(now())

  @@index([productId])
  @@index([variantId])
  @@map("inventory_transactions")
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  provider       String         @default("manual")
  shipmentId     String?
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus @default(CREATED)
  awb            String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@map("shipments")
}

model Wishlist {
  id        String   @id @default(uuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("wishlists")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("settings")
}
