{
  "name": "safedrang-backend",
  "version": "1.0.0",
  "description": "Safed Rang E-Commerce Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/app.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/app.js",
    "prisma:generate": "node node_modules/prisma/dist/prisma.js generate || npx prisma generate",
    "prisma:migrate": "node node_modules/prisma/dist/prisma.js migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "node node_modules/prisma/dist/prisma.js studio",
    "test": "echo \"Tests not configured yet\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "ecommerce",
    "safedrang",
    "api"
  ],
  "author": "Safed Rang",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "argon2": "^0.45.1",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cashfree-pg": "^6.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
