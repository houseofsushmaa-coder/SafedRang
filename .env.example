# =============================================
# SAFED RANG — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git
# =============================================

# Supabase (get from: https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cashfree Payment Gateway (get from: https://merchant.cashfree.com/merchants/login)
VITE_CASHFREE_APP_ID=your-cashfree-app-id
VITE_CASHFREE_ENV=SANDBOX
# ⚠️ LOCAL DEV ONLY — move to Supabase Edge Function secrets before production deploy
VITE_CASHFREE_SECRET_KEY=your-cashfree-secret-key
